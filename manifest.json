{
  "manifest_version": 1,
  "name": "F@st-reply",
  "version": "1.0",
  "description": "Uma extensão simples de exemplo.",
  "icons": {
    "48": "icon-48.png"
  },
  "action": {
    "default_icon": "icon-48.png",
    "default_title": "Clique para abrir o popup",
    "default_popup": "index.html"
  },
  "permissions": ["storage", "activeTab"]
}
